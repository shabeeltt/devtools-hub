---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PasswordGenerator from "../../features/password-generator/PasswordGenerator";
---

<BaseLayout
  title="Password Generator | Secure Random Password Creator"
  description="Generate secure random passwords or memorable passphrases with customizable length and complexity."
>
  <div class="mb-8">
    <h2 class="mb-2 text-3xl font-bold tracking-tight text-primary">
      Password Generator
    </h2>

    <p class="text-secondary">
      Generate secure random passwords or memorable passphrases with customizable length and complexity.
    </p>
  </div>

  <PasswordGenerator client:load />
</BaseLayout>