---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CssUnitConverter from "../../features/css-unit-converter/CssUnitConverter";
---

<BaseLayout
  title="CSS Unit Converter | Free Developer Tool"
  description="Convert between px, em, rem, %, vw and vh instantly."
>
  <h2 class="mb-6 text-2xl font-semibold">
    CSS Unit Converter
  </h2>

  <p class="text-secondary">
    Convert between common CSS units instantly.
  </p>

  <CssUnitConverter client:load />
</BaseLayout>
